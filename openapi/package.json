{
  "name": "@the-fundamentals/core-openapi",
  "version": "0.2.0",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.gen.d.ts",
      "import": "./dist/client.gen.js"
    },
    "./react-query": {
